extends SceneTree
const Sim = preload("res://scripts/release_simulation.gd")
const C = preload("res://scripts/release_combat.gd")
const E = preload("res://scripts/release_encounters.gd")
var checks := 0
var failures := 0
func check(ok: bool, message: String) -> void:
	checks += 1
	if not ok: failures += 1; push_error(message)
func fresh(fusion: String = ""):
	var sim := Sim.new(7, "campaign", {"runId": "combat"})
	sim.start(); sim.state.spawnTimer = 9999; sim.state.eliteTimer = 9999
	for id in sim.state.spells: sim.state.spells[id] = 0
	if not fusion.is_empty():
		sim.state.fusions = [fusion]
		for item in sim.catalog.fusions:
			if item.id == fusion:
				for id in item.requires: sim.state.spells[id] = 3
	return sim
func enemy(sim, point: Vector2, kind: String = "normal", hp: float = 100) -> Dictionary:
	var v := E.enemy(sim, 1, 0, point); v.hp = hp; v.maxHp = hp; v.speed = 0; v.kind = kind
	return v
func count_fields(sim, kind: String) -> int:
	return sim.state.fields.filter(func(f): return f.kind == kind).size()
func _initialize() -> void:
	var s = fresh("plasma"); var a := enemy(s, Vector2(100, 0)); var b := enemy(s, Vector2(200, 0)); C.plasma(s, Vector2.RIGHT, 3, s.context("bolt"))
	check(a.hp < 100 and b.hp < 100 and s.status_time(a, "shock") > 0, "F01 piercing beam shocks each target")
	s = fresh("blizzard"); a = enemy(s, Vector2(180, 0)); C.advance(s, 0.01)
	check(a.hp < 100 and s.status_time(a, "slow") >= 3, "F02 cold enlarged range and slow")
	s = fresh("supernova"); a = enemy(s, Vector2(300, 0)); C.advance(s, 0.01)
	check(s.state.fields.any(func(f): return f.kind == "meteor_warning" and f.maxLife == 1 and f.radius >= 180), "F03 wider delayed impact")
	s = fresh("hyperion"); check(s.orbit_position(0).length() >= 105, "F04 wider sword orbit")
	s = fresh("f05"); a = enemy(s, Vector2(100, 0)); s.apply_damage(a, 2, s.context("bolt"))
	check(s.state.projectiles.size() == 2 and s.state.projectiles.all(func(p): return p.context.depth == 1), "F05 two nonrecursive shard branches")
	s = fresh("f06"); var orbit: Vector2 = s.orbit_position(0); a = enemy(s, orbit); C.field(s, "electric_ring", orbit, 70, 3); C.orbit(s)
	check(s.status_time(a, "shock") > 0 and not s.state.orbitCharges["0"].charged, "F06 crossing ring charges one sword contact")
	s = fresh("f07"); a = enemy(s, Vector2(10, 0)); b = enemy(s, Vector2(80, 0)); C.explode(s, Vector2.ZERO, 100, 1, s.context("fireball"), "fireball")
	check(s.status_time(a, "ignite") > 0 and s.status_time(a, "slow") == 0 and s.status_time(b, "slow") > 0 and s.status_time(b, "ignite") == 0, "F07 mutually exclusive inner/outer explosion effects")
	s = fresh("f08"); a = enemy(s, Vector2(80, 0)); b = enemy(s, Vector2(80, 0), "boss"); C.field(s, "meteor_warning", Vector2.ZERO, 100, 1, {"damage": 1, "context": s.context("meteor")}); C.update_fields(s, 0.1)
	check(a.x < 80 and b.x == 80, "F08 warning pulls ordinary targets only")
	s = fresh("f09"); a = enemy(s, s.orbit_position(0)); C.orbit(s)
	check(s.state.projectiles.any(func(p): return p.sourceId == "f09" and p.context.depth == 1), "F09 sword contact launches one derived dagger")
	s = fresh("f10"); s.state.spells.lightning = 1; C.field(s, "wall", Vector2(60, 0), 100, 3, {"direction": Vector2.UP, "width": 20}); a = enemy(s, Vector2(100, 0)); b = enemy(s, Vector2(180, 0)); var d := enemy(s, Vector2(260, 0)); C.lightning(s, a, 1, s.context("lightning"))
	check(a.hp < 100 and b.hp < 100 and d.hp < 100, "F10 wall crossing grants one extra distinct jump")
	s = fresh("f11"); a = enemy(s, Vector2.ZERO); C.explode(s, Vector2.ZERO, 100, 1, s.context("meteor"), "meteor")
	check(count_fields(s, "ash") == 1 and s.state.fields[0].life == 2, "F11 meteor leaves two-second ash field")
	s = fresh("f12")
	for i in range(5): enemy(s, Vector2(i * 12, 0))
	C.field(s, "pulse", Vector2.ZERO, 250, 0.6, {"damage": 1, "context": s.context("pulse"), "currentRadius": 0.0, "glyphCount": 0}); C.update_fields(s, 0.6)
	check(count_fields(s, "glyph") == 3, "F12 pulse glyph cap3")
	s = fresh("f13"); a = enemy(s, Vector2(100, 0)); b = enemy(s, Vector2(240, 0)); s.apply_status(b, "ignite", 3); s.state.cooldowns.m17 = 4; C.lightning(s, a, 3, s.context("lightning"))
	check(s.state.cooldowns.m17 < 4 and b.hp < 100, "F13 ignited chain shortens heatwave timer")
	s = fresh("f14"); a = enemy(s, Vector2(100, 0)); C.field(s, "wall", Vector2(50, 0), 70, 3, {"direction": Vector2.UP, "width": 22}); C.projectile(s, "bolt", Vector2(40, 0), Vector2.RIGHT, 1); C.update_projectiles(s, 0.1)
	check(s.status_time(a, "slow") > 0, "F14 bolt crossing wall becomes slowing")
	s = fresh("f15"); a = enemy(s, Vector2(100, 0)); C.field(s, "mine", Vector2(100, 0), 18, 3, {"damage": 5, "context": s.context("m16")}); C.field(s, "pulse", Vector2.ZERO, 200, 0.6, {"damage": 1, "context": s.context("pulse"), "currentRadius": 0.0, "glyphCount": 0}); C.update_fields(s, 0.6)
	check(count_fields(s, "mine") == 0 and a.hp <= 94, "F15 pulse detonates mine once")
	s = fresh("f16"); a = enemy(s, Vector2.ZERO); C.field(s, "vortex", Vector2.ZERO, 100, 4, {"damage": 0, "context": s.context("vortex")})
	for i in range(4): C.update_fields(s, 0.5)
	check(s.status_time(a, "vulnerable") > 0, "F16 sustained vortex exposure applies vulnerable")
	s = fresh("f17"); a = enemy(s, Vector2(50, 0)); b = enemy(s, Vector2(75, 0)); s.apply_status(a, "ignite", 3); s.apply_damage(a, 1, s.context("m13"))
	check(s.status_time(b, "ignite") > 0, "F17 dagger spreads ember to one neighbour")
	s = fresh("f18"); a = enemy(s, Vector2(50, 0)); b = enemy(s, Vector2(160, 0)); C.field(s, "glyph", Vector2(160, 0), 25, 3, {"damage": 0}); C.mark(s, a.id, s.context("m19")); C.update_marks(s, 0.1)
	check(s.state.marks[0].targetId == b.id and s.state.marks[0].retargeted, "F18 mark redirects once into glyph")
	s = fresh("f19"); a = enemy(s, Vector2(30, 0)); s.apply_status(a, "vulnerable", 3); C.field(s, "veil", Vector2.ZERO, 100, 3); C.advance(s, 0.01)
	check(s.status_time(a, "vulnerable") == 4, "F19 frost inside veil extends vulnerability to4")
	s = fresh("f20"); s.state.player.hp = 4; s.state.healBudget = 0.3; s.spawn_seed(Vector2(70, 0)); C.field(s, "pulse", Vector2.ZERO, 150, 0.6, {"damage": 1, "context": s.context("pulse"), "currentRadius": 0.0, "glyphCount": 0}); C.update_fields(s, 0.6)
	check(s.state.seeds.is_empty() and s.state.player.hp > 4, "F20 wave collects seed once")
	s = fresh("f21"); a = enemy(s, Vector2.ZERO, "normal", 0.1); C.field(s, "well", Vector2.ZERO, 100, 3); s.apply_damage(a, 1, s.context("bolt"))
	check(s.state.echoKills == 2, "F21 ordinary well kill gives extra heal progress")
	s = fresh("f22"); a = enemy(s, Vector2(50, 0)); a.speed = 200; b = enemy(s, Vector2(100, 0)); b.delayedUntil = 5
	check(C.choose_target(s, "m19").id == b.id, "F22 delayed normal overrides fastest mark target")
	s = fresh("f23"); var radius: float = s.orbit_position(0).length(); s.hurt_player(9)
	check((s.orbit_position(0) - s._pos(s.state.player)).length() > radius, "F23 fatal return pushes orbit outward temporarily")
	s = fresh("f24"); C.field(s, "mine", Vector2.ZERO, 18, 3, {"damage": 3}); C.explode(s, Vector2.ZERO, 100, 1, s.context("meteor"), "meteor")
	check(s.state.projectiles.size() == 4 and count_fields(s, "mine") == 0, "F24 meteor consumes mine into4 nonrecursive fragments")
	s = fresh("f25"); a = enemy(s, Vector2(100, 60)); C.field(s, "electric_ring", Vector2.ZERO, 80, 3, {"damage": 0, "context": s.context("m11")}); C.advance(s, 0.01)
	check(a.hp < 100, "F25 heatwave becomes arc beyond straight strip")
	s = fresh("f26"); a = enemy(s, Vector2(80, 0)); s.apply_status(a, "slow", 2); C.advance(s, 0.01)
	check(a.get("winterDaggerAt", 0) == 2, "F26 slowing needle opens2second dagger bonus window")
	s = fresh("f27"); a = enemy(s, Vector2(100, 50)); s.state.enemyProjectiles = [{"id": 2, "ownerId": a.id, "x": 50.0, "y": 0.0, "vx": 100.0, "vy": 0.0, "radius": 5, "beam": false}]; C.deflect(s, Vector2.ZERO, 120, 0.4)
	check(a.hp < 100, "F27 deflected bullet emits weak directional arc")
	s = fresh("f28"); s.state.safeTime = 7.99; C.field(s, "glyph", Vector2.ZERO, 100, 3, {"damage": 0}); s._advance_player(0.02, Vector2.ZERO)
	check(s.state.combatLog.any(func(x): return x.get("seedSpawned", false)), "F28 glyph reduces seed clock to8seconds")
	s = fresh("f29"); a = enemy(s, Vector2(50, 0)); b = enemy(s, Vector2(250, 0)); s.apply_status(b, "vulnerable", 3)
	check(C.choose_target(s, "meteor").id == b.id, "F29 meteor selects vulnerable distant target")
	s = fresh("f30"); a = enemy(s, Vector2.ZERO); C.field(s, "electric_ring", Vector2(40, 0), 60, 4, {"damage": 0, "context": s.context("m11")}); C.field(s, "well", Vector2.ZERO, 100, 4, {"ringHits": {}})
	for i in range(5): C.update_fields(s, 0.5)
	check(is_equal_approx(a.hp, 97), "F30 well ring shock hits target at most twice")
	s = fresh("f31"); C.field(s, "wall", Vector2.ZERO, 100, 3, {"direction": Vector2.UP, "width": 22, "deflected": 0})
	for i in range(10): s.state.enemyProjectiles.append({"id": i, "x": 0.0, "y": 0.0, "vx": 100.0, "vy": 0.0, "beam": false})
	C.update_fields(s, 0.01)
	check(s.state.enemyProjectiles.filter(func(x): return x.get("deflected", false)).size() == 8, "F31 wall deflection cap8")
	s = fresh("f32"); s.state.echoKills = 9; a = enemy(s, Vector2(80, 0), "normal", 0.1); s.apply_damage(a, 1, s.context("bolt"))
	check(count_fields(s, "ash_warning") > 0, "F32 healthy kill threshold trades heal for ash")
	s = fresh("f33"); a = enemy(s, Vector2(80, 0)); a.delayedUntil = 3; C.advance(s, 0.01)
	check(s.status_time(a, "mark") > 0, "F33 delayed normal receives dagger mark")
	s = fresh("f34"); a = enemy(s, Vector2.ZERO); C.field(s, "glyph", Vector2.ZERO, 100, 3, {"damage": 0, "context": s.context("m15")}); C.field(s, "vortex", Vector2.ZERO, 100, 3, {"damage": 0, "context": s.context("vortex")}); C.update_fields(s, 0.01)
	check(a.get("glyphDashSlow", 0) > 0, "F34 overlapping glyph ground reduces dash speed")
	s = fresh("f35"); a = enemy(s, Vector2(30, 0)); s.hurt_player(9)
	check(a.hp < 100 and s.state.player.x < 0, "F35 return explosion stays at departure point")
	s = fresh("f36"); a = enemy(s, Vector2(80, 0)); s.state.enemyProjectiles = [{"id": 2, "ownerId": a.id, "x": 50.0, "y": 0.0, "vx": 100.0, "vy": 0.0, "beam": false}]; C.deflect(s, Vector2.ZERO, 120, 0.4)
	check(s.state.marks.size() == 1 and s.state.marks[0].targetId == a.id, "F36 one deflected projectile marks actual shooter")
	# Branch tradeoffs have numerical and spatial effects, not card-only strings.
	for branch in ["F01-R1", "F01-R2", "F01-R3"]:
		s = fresh("plasma"); s.state.resonances.plasma = branch; a = enemy(s, Vector2(100, 0)); s.apply_status(a, "shock", 2); C.plasma(s, Vector2.RIGHT, 3, s.context("bolt"))
		check(a.hp < 100, branch + " beam damage")
		if branch == "F01-R1": check(is_equal_approx(s.state.effects[0].radius, 9.8), "focus beam narrower")
		if branch == "F01-R2": check(s.state.projectiles.size() == 2, "spectrum branches twice")
		if branch == "F01-R3": check(s.state.plasmaStored == 0.92, "capacitor stores next cooldown reduction")
	s = fresh("blizzard"); s.state.resonances.blizzard = "F02-R1"; a = enemy(s, Vector2.ZERO); s.apply_status(a, "slow", 2)
	check(is_equal_approx(s.status_time(a, "slow"), 2.8), "F02R1 longer slow")
	s = fresh("blizzard"); s.state.resonances.blizzard = "F02-R2"; a = enemy(s, Vector2.ZERO); s.apply_status(a, "slow", 0.5); C.advance_effects(s, 0.5)
	check(a.hp < 100 and not a.statuses.has("slow"), "F02R2 shatter on shorter slow expiry")
	s = fresh("blizzard"); s.state.resonances.blizzard = "F02-R3"; C.field(s, "vortex", Vector2(100, 0), 80, 3, {"damage": 1, "context": s.context("vortex")}); C.update_fields(s, 0.1)
	check(s.state.fields[0].x < 100, "F02R3 ground follows at half speed")
	s = fresh("supernova"); s.state.resonances.supernova = "F03-R1"; a = enemy(s, Vector2.ZERO); C.explode(s, Vector2.ZERO, 100, 10, s.context("meteor"), "meteor")
	check(is_equal_approx(a.hp, 79), "F03R1 meteor damage gains40percent")
	s = fresh("supernova"); s.state.resonances.supernova = "F03-R2"; C.explode(s, Vector2.ZERO, 100, 10, s.context("meteor"), "meteor")
	check(count_fields(s, "burn") == 1, "F03R2 weaker impact leaves3second burn")
	s = fresh("supernova"); s.state.resonances.supernova = "F03-R3"; C.cooldown(s, "meteor", 6)
	check(is_equal_approx(s.state.cooldowns.meteor, 4.8), "F03R3 shorter cooldown")
	s = fresh("hyperion"); s.state.resonances.hyperion = "F04-R1"
	check(is_equal_approx(s.orbit_position(0).length(), 147), "F04R1 longer orbit")
	s = fresh("hyperion"); s.state.resonances.hyperion = "F04-R2"; a = enemy(s, s.orbit_position(0)); C.orbit(s)
	check(s.state.orbitPulseAt == 1 and is_equal_approx(a.hp, 96.1), "F04R2 smaller sword triggers weak pulse once/sec")
	s = fresh("hyperion"); s.state.resonances.hyperion = "F04-R3"; a = enemy(s, Vector2(100, 0)); C.advance(s, 0.01)
	check(s.state.fields.any(func(x): return x.kind == "pulse" and x.radius > 280) and is_equal_approx(s.state.cooldowns.pulse, 4.125), "F04R3 stronger larger pulse pays longer cooldown")
	# Each explosion is a distinct proc owner even when cast/attack provenance is shared.
	s = fresh(); s.state.artifacts = ["a081"]; a = enemy(s, Vector2.ZERO, "normal", 1000)
	var shared: Dictionary = s.context("fireball")
	C.explode(s, Vector2.ZERO, 80, 1, shared, "fireball")
	C.explode(s, Vector2.ZERO, 80, 1, shared, "fireball")
	var splits: Array = s.state.combatLog.filter(func(e): return e.get("sourceId", "") == "a081" and e.kind == "hit")
	var originals: Array = s.state.combatLog.filter(func(e): return e.get("sourceId", "") == "fireball" and e.kind == "hit")
	check(splits.size() == 4 and originals.size() == 2 and originals[0].attackId == originals[1].attackId and originals[0].explosionId != originals[1].explosionId, "A081 two explosions sharing attackId each split exactly once")
	s = fresh(); s.state.spells.fireball = 1; s.state.artifacts = ["a027"]; a = enemy(s, Vector2(100, 0)); C.advance(s, 0.01)
	check(is_equal_approx(s.state.projectiles[0].explosionRadius, 73 * 1.08), "A027 expands fireball explosion at cast")
	s = fresh(); s.state.spells.meteor = 1; s.state.artifacts = ["a027", "a035"]; a = enemy(s, Vector2(100, 0)); C.advance(s, 0.01)
	var warning: Dictionary = s.state.fields[0]
	check(is_equal_approx(warning.radius, 107 * 1.08 * 1.1) and is_equal_approx(warning.damageRadius, 107 * 1.08) and is_equal_approx(warning.maxLife, 0.7), "A035 expands meteor warning only while A027 expands actual explosion")
	s = fresh(); s.state.spells.pulse = 1; s.state.artifacts = ["a088"]; a = enemy(s, Vector2(40, 0)); b = enemy(s, Vector2(50, 0))
	C.field(s, "pulse", Vector2.ZERO, 150, 0.6, {"damage": 1, "context": s.context("pulse"), "currentRadius": 0.0, "glyphCount": 0}); C.update_fields(s, 0.6)
	check(s.status_time(a, "mark") > 0 and s.status_time(b, "mark") == 0, "A088 arcane pulse marks only first target of same attack")
	s = fresh(); s.state.artifacts = ["a024"]; a = enemy(s, Vector2.ZERO, "normal", 1000)
	for i in range(2): C.field(s, "vortex", Vector2.ZERO, 100, 3, {"damage": 1, "sourceId": "vortex", "context": s.context("vortex")})
	C.update_fields(s, 0.01); s.state.time = 0.45; C.update_fields(s, 0.45)
	check(is_equal_approx(a.hp, 998), "A024 vortex shared gate follows0.45s interval while overlapping fields remain deduplicated")
	print("Release combat: %d checks, %d failures" % [checks, failures]); quit(1 if failures else 0)
